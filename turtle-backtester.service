[Unit]
Description=Turtle Backtester Streamlit Web App
After=network.target

[Service]
User=root
WorkingDirectory=/opt/turtle_backtest_webapp
ExecStart=/opt/turtle_backtest_webapp/venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
